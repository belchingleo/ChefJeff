{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "title": "Level: composes referenced content into one runnable round",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "name",
    "ruleset_ref",
    "map_ref",
    "equipment_catalog_ref",
    "recipe_catalog_ref",
    "order_policy_ref",
    "actors",
    "spawns",
    "initial_inventory",
    "clock",
    "round_limit_game_ms",
    "goal",
    "end_policy",
    "scoring",
    "seeds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "level"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/display_name"
    },
    "menu_order": {
      "type": "integer",
      "minimum": 0
    },
    "ruleset_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "map_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "equipment_catalog_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "recipe_catalog_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "order_policy_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "actor_id",
          "controller_type"
        ],
        "properties": {
          "actor_id": {
            "enum": [
              "human",
              "jeff"
            ]
          },
          "controller_type": {
            "enum": [
              "human",
              "agent",
              "scripted"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "spawns": {
      "type": "object",
      "required": [
        "rule",
        "centers",
        "partition"
      ],
      "properties": {
        "rule": {
          "const": "nearest_floor_to_center_shuffled"
        },
        "centers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "partition": {
          "type": "object",
          "required": [
            "axis",
            "split"
          ],
          "properties": {
            "axis": {
              "enum": [
                "x",
                "y"
              ]
            },
            "split": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "initial_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object",
          "id",
          "at"
        ],
        "properties": {
          "object": {
            "enum": [
              "plate",
              "pot",
              "extinguisher"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{1,3}$"
          },
          "state": {
            "enum": [
              "clean",
              "dirty"
            ]
          },
          "at": {
            "$ref": "common.schema.json#/$defs/station_id"
          }
        },
        "additionalProperties": false
      }
    },
    "clock": {
      "type": "object",
      "required": [
        "game_per_wall_default",
        "game_per_wall_options"
      ],
      "properties": {
        "game_per_wall_default": {
          "$ref": "common.schema.json#/$defs/positive_number"
        },
        "game_per_wall_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/positive_number"
          }
        }
      },
      "additionalProperties": false
    },
    "round_limit_game_ms": {
      "$ref": "common.schema.json#/$defs/positive_game_ms"
    },
    "goal": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "min_served",
            "min_money",
            "max_bad_reviews"
          ],
          "properties": {
            "type": {
              "const": "legacy_all_gates"
            },
            "min_served": {
              "type": "integer",
              "minimum": 0
            },
            "min_money": {
              "$ref": "common.schema.json#/$defs/money"
            },
            "max_bad_reviews": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "min_money"
          ],
          "properties": {
            "type": {
              "const": "minimum_money"
            },
            "min_money": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "end_policy": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "legacy_immediate",
            "fixed_round"
          ]
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": [
        "time_bonus_per_second"
      ],
      "properties": {
        "time_bonus_per_second": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "seeds": {
      "description": "null means drawn at freeze time and recorded in the resolved configuration.",
      "type": "object",
      "required": [
        "orders",
        "spawn"
      ],
      "properties": {
        "orders": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "spawn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
