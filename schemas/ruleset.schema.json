{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruleset.schema.json",
  "title": "Ruleset: engine-supported execution semantics",
  "description": "Selects rules the engine already implements. It cannot add new mechanics.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "engine_semantics",
    "tick_game_ms",
    "supported_equipment_types",
    "operations",
    "movement",
    "throw",
    "tableware",
    "fire",
    "penalties",
    "abstract_travel",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "ruleset"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/display_name"
    },
    "engine_semantics": {
      "enum": [
        "legacy-2026-09",
        "continuous-2026-09"
      ]
    },
    "tick_game_ms": {
      "const": 50
    },
    "supported_equipment_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ingredient_source",
          "board",
          "stove",
          "counter",
          "serving_window",
          "bin",
          "sink",
          "plate_return",
          "tool_rack"
        ]
      }
    },
    "operations": {
      "type": "object",
      "required": [
        "handling_game_ms",
        "extinguish_game_ms",
        "clear_game_ms"
      ],
      "properties": {
        "handling_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "extinguish_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "clear_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        }
      },
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "required": [
        "walk_cells_per_game_s",
        "sprint_multiplier",
        "sprint_duration_game_ms",
        "sprint_cooldown_game_ms",
        "chef_separation_cells",
        "sprint_push_cells",
        "sprint_food_nudge_cells"
      ],
      "properties": {
        "walk_cells_per_game_s": {
          "$ref": "common.schema.json#/$defs/positive_number"
        },
        "sprint_multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "sprint_duration_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "sprint_cooldown_game_ms": {
          "$ref": "common.schema.json#/$defs/game_ms"
        },
        "chef_separation_cells": {
          "$ref": "common.schema.json#/$defs/positive_number"
        },
        "sprint_push_cells": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "One-time push applied to the other chef by a sprint impulse."
        },
        "sprint_food_nudge_cells": {
          "description": "Maximum distance a sprint moves each loose ground ingredient.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "throw": {
      "type": "object",
      "required": [
        "enabled",
        "range_cells",
        "speed_cells_per_game_s",
        "min_flight_game_ms",
        "catch_radius_cells"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "range_cells": {
          "$ref": "common.schema.json#/$defs/positive_number"
        },
        "speed_cells_per_game_s": {
          "$ref": "common.schema.json#/$defs/positive_number"
        },
        "min_flight_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "catch_radius_cells": {
          "$ref": "common.schema.json#/$defs/positive_number"
        }
      },
      "additionalProperties": false
    },
    "tableware": {
      "type": "object",
      "required": [
        "dining_game_ms",
        "return_capacity"
      ],
      "properties": {
        "dining_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "return_capacity": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "fire": {
      "type": "object",
      "required": [
        "spread_interval_game_ms",
        "loss_threshold"
      ],
      "properties": {
        "spread_interval_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "loss_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "penalties": {
      "type": "object",
      "required": [
        "wrong_or_burnt_dish",
        "expired_order",
        "new_fire",
        "discard"
      ],
      "properties": {
        "wrong_or_burnt_dish": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "expired_order": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "new_fire": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "discard": {
          "$ref": "common.schema.json#/$defs/money"
        }
      },
      "additionalProperties": false
    },
    "abstract_travel": {
      "description": "Travel time of the non-spatial text prototype only.",
      "type": "object",
      "required": [
        "same_area_game_ms",
        "cross_area_game_ms"
      ],
      "properties": {
        "same_area_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "cross_area_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "description": "Technical safety limits, measured on the current engine; not game difficulty.",
      "type": "object",
      "required": [
        "max_actors",
        "max_equipment",
        "max_orders",
        "max_round_game_ms",
        "max_document_bytes",
        "max_inventory"
      ],
      "properties": {
        "max_actors": {
          "const": 2
        },
        "max_equipment": {
          "type": "integer",
          "minimum": 1
        },
        "max_orders": {
          "type": "integer",
          "minimum": 1
        },
        "max_round_game_ms": {
          "$ref": "common.schema.json#/$defs/positive_game_ms"
        },
        "max_document_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_inventory": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
