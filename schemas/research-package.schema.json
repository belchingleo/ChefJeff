{
  "type": "object",
  "properties": {
    "format": {
      "const": "chefjeff-research-package-v1"
    },
    "created_at": {
      "type": "string"
    },
    "expires": {
      "type": "number",
      "minimum": 0
    },
    "source": {
      "const": "private_sqlite_read_only"
    },
    "rounds": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "expires": {
            "type": "number",
            "minimum": 0
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "source_ref",
          "expires",
          "record_sha256"
        ],
        "additionalProperties": false
      }
    },
    "authenticated": {
      "const": false
    },
    "annotations": {
      "type": "string"
    },
    "deletion": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "created_at",
    "expires",
    "source",
    "rounds",
    "artifacts",
    "sources",
    "authenticated",
    "annotations",
    "deletion"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-package.schema.json"
}
