{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.schema.json",
  "title": "Order policy: demand and rhythm, not production",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "mode",
    "patience_default_game_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "order_policy"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/display_name"
    },
    "mode": {
      "enum": [
        "fixed_interval_seeded",
        "fixed_table"
      ]
    },
    "first_spawn_game_ms": {
      "$ref": "common.schema.json#/$defs/game_ms"
    },
    "interval_game_ms": {
      "$ref": "common.schema.json#/$defs/positive_game_ms"
    },
    "stop_spawn_game_ms": {
      "$ref": "common.schema.json#/$defs/positive_game_ms",
      "description": "Optional; defaults to the round limit (orders keep arriving until closing)."
    },
    "keep_open": {
      "type": "integer", "minimum": 0, "maximum": 5,
      "description": "Overcooked 2's order flow: whenever fewer orders than this are waiting, the next one arrives at once (its default is 2). Absent or 0: orders keep the plan's times."
    },
    "max_open": {
      "type": "integer", "minimum": 1, "maximum": 5,
      "description": "Overcooked 2's order flow: no new order while this many are waiting (its default is 5); the timed one waits for a place."
    },
    "on_expire": {
      "enum": ["leave", "restart"],
      "description": "An order whose time runs out: leave (it is gone, the default) or restart (it stays and its countdown starts again, as Overcooked 2's ResetOrderLifetime). Both cost the expired-order penalty."
    },
    "patience_default_game_ms": {
      "$ref": "common.schema.json#/$defs/positive_game_ms"
    },
    "patience_by_recipe": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/positive_game_ms"
      }
    },
    "menu": {
      "description": "fixed_interval_seeded: positive weights, sampled in stable recipe_ref order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recipe_ref",
          "weight"
        ],
        "properties": {
          "recipe_ref": {
            "$ref": "common.schema.json#/$defs/ident"
          },
          "weight": {
            "$ref": "common.schema.json#/$defs/positive_number"
          }
        },
        "additionalProperties": false
      }
    },
    "arrivals": {
      "description": "fixed_table: explicit arrivals.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recipe_ref",
          "arrival_game_ms"
        ],
        "properties": {
          "recipe_ref": {
            "$ref": "common.schema.json#/$defs/ident"
          },
          "arrival_game_ms": {
            "$ref": "common.schema.json#/$defs/game_ms"
          },
          "patience_game_ms": {
            "$ref": "common.schema.json#/$defs/positive_game_ms"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
